# ============================================================
# 한국투자증권 KIS API
# 발급: https://apiportal.koreainvestment.com → 앱 신청
# ============================================================
KIS_APP_KEY=your_app_key_here
KIS_APP_SECRET=your_app_secret_here
KIS_ACCOUNT_NO=12345678-01        # 계좌번호 (앞 8자리-뒤 2자리)
KIS_MOCK=true                     # true=모의투자, false=실전투자

# ============================================================
# 업비트 API
# 발급: 업비트 로그인 → 마이페이지 → Open API 관리
# ============================================================
UPBIT_ACCESS_KEY=your_access_key_here
UPBIT_SECRET_KEY=your_secret_key_here

# ============================================================
# AI 엔진
#   AI_PROVIDER=ollama    → 로컬 LLM, API 키/결제 불필요 (기본·무료)
#   AI_PROVIDER=anthropic → Claude (ANTHROPIC_API_KEY 필요)
# ============================================================
AI_PROVIDER=ollama

# Ollama (로컬) — https://ollama.com 설치 후: ollama pull qwen2.5
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5

# Anthropic (AI_PROVIDER=anthropic 일 때만 필요)
# ANTHROPIC_API_KEY=your_anthropic_key_here
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ============================================================
# 트레이딩 설정
# ============================================================
TRADE_INTERVAL_MINUTES=30         # AI 분석 주기 (분)
MAX_POSITION_RATIO=0.1            # 종목당 최대 비중 (10%)
STOP_LOSS_RATIO=0.05              # 손절 비율 (5%)
TAKE_PROFIT_RATIO=0.15            # 익절 비율 (15%)
MAX_STOCK_POSITIONS=5             # 주식 최대 보유 종목 수
MAX_CRYPTO_POSITIONS=3            # 코인 최대 보유 종목 수

# ============================================================
# 웹 서버
# ============================================================
WEB_HOST=0.0.0.0
WEB_PORT=8000
